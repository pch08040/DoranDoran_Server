# 이 파일을 복사해서 .env 로 만든 뒤 값을 채우세요:  cp .env.example .env
# .env 는 git에 올라가지 않습니다(.gitignore). 로컬 개발용 기본값 예시입니다.

# 서버 (이미지 URL 생성 등에 사용)
SERVER_PROTOCOL=http
SERVER_HOST=localhost
SERVER_PORT=3000
PORT=3000

# 인증 (아무 문자열이나 가능, 컴퓨터마다 달라도 됨)
JWT_SECRET=change_me
HASH_ROUNDS=10

# 데이터베이스 (docker-compose가 postgres를 호스트 5431 포트로 노출)
DB_HOST=localhost
DB_PORT=5431
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=dorandoran

# 실행 환경 (development / production)
# production 으로 두면 개발용 API(더미 생성, 전체 삭제)가 404로 막히고
# 인증번호가 서버 로그에도 찍히지 않습니다.
NODE_ENV=development

# Redis (인증번호 임시 보관용, docker-compose가 6379 포트로 띄움)
REDIS_HOST=localhost
REDIS_PORT=6379

# 사진 보관용 Google Cloud Storage 버킷
# 개발: dorandoran-462503-images-dev / 운영: dorandoran-462503-images
GCS_BUCKET=dorandoran-462503-images-dev
